# Required: Anthropic API key for the agent.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model override. Defaults to claude-opus-4-7 (pinned in core/constants.py).
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional: Nominatim user-agent (good citizen on public endpoint).
# NOMINATIM_USER_AGENT=agentic-cab-rides/0.1 (your-email@example.com)
