# Required: Anthropic API key for the agent.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model override. Defaults to claude-opus-4-7 (pinned in core/constants.py).
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional: Nominatim user-agent (good citizen on public endpoint).
# NOMINATIM_USER_AGENT=agentic-cab-rides/0.1 (your-email@example.com)

# Optional: runtime paths and web port (core/settings.py). Give each instance its
# own values to run several side by side. Relative paths resolve from the cwd;
# an empty value means "use the default".
# SQLite state (state.db) and, by default, the live geocode cache.
# AGENTIC_CAB_DATA_DIR=data
# Action-log JSONL (<session_id>.jsonl).
# AGENTIC_CAB_LOG_DIR=logs
# Chat-history JSONL (<session_id>.chat.jsonl). Defaults to the log dir.
# AGENTIC_CAB_CHAT_DIR=logs
# Writable geocode cache. Defaults to <data dir>/geocode. The committed
# fixtures/geocode is read-only at runtime; this may not point inside it.
# AGENTIC_CAB_GEOCODE_CACHE_DIR=data/geocode
# Port for `make web` / `make demo` / `python -m agentic_cab web`.
# AGENTIC_CAB_WEB_PORT=8000
